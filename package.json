{
  "name": "medical-trend-lab-booking",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "tsc -b && vite build",
    "images": "node scripts/optimize-images.mjs",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply medical-trend-booking --local",
    "db:migrate": "wrangler d1 migrations apply medical-trend-booking --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.142.0"
  }
}
